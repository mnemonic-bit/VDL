from flask import Flask, render_template_string, request, jsonify
import yt_dlp
import threading
import uuid

app = Flask(__name__)

# In-memory database to store download histories and their progress
# Format: { "id": {"url": "...", "status": "pending", "progress": "0%"} }
downloads = {}

HTML_TEMPLATE = """
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Downloader</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 800px; margin: 40px auto; padding: 20px; }
        .form-group { margin-bottom: 20px; }
        input[type="url"] { width: 70%; padding: 10px; }
        button { padding: 10px 20px; cursor: pointer; }
        .history-item { border: 1px solid #ccc; padding: 15px; margin-bottom: 10px; border-radius: 5px; }
        .progress-bar-bg { width: 100%; background-color: #f3f3f3; border-radius: 5px; margin-top: 10px;}
        .progress-bar-fill { height: 20px; background-color: #4caf50; border-radius: 5px; width: 0%; transition: width 0.4s ease;}
    </style>
</head>
<body>
    <h2>Download Video</h2>
    <div class="form-group">
        <input type="url" id="urlInput" placeholder="Enter video URL here..." required>
        <button onclick="startDownload()">Download</button>
    </div>

    <h3>Download History</h3>
    <div id="historyList"></div>

    <script>
        // Trigger download via API
        function startDownload() {
            const url = document.getElementById('urlInput').value;
            if (!url) return alert('Please enter a URL');
            
            fetch('/api/download', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url: url })
            })
            .then(res => res.json())
            .then(data => {
                document.getElementById('urlInput').value = '';
                fetchHistory(); // Refresh the list immediately
            });
        }

        // Poll the server every second to update progress
        function fetchHistory() {
            fetch('/api/history')
            .then(res => res.json())
            .then(data => {
                const list = document.getElementById('historyList');
                list.innerHTML = '';
                
                // Reverse to show newest first
                Object.entries(data).reverse().forEach(([id, info]) => {
                    let progressText = info.status === 'finished' ? 'Complete' : 
                                       info.status === 'error' ? 'Error' : info.progress;
                    
                    // Parse numeric value for the width of the bar
                    let width = progressText.replace('%', '');
                    if (isNaN(width)) width = info.status === 'finished' ? 100 : 0;

                    list.innerHTML += `
                        <div class="history-item">
                            <strong>URL:</strong> ${info.url}<br>
                            <strong>Status:</strong> ${info.status} (${progressText})
                            <div class="progress-bar-bg">
                                <div class="progress-bar-fill" style="width: ${width}%;"></div>
                            </div>
                        </div>
                    `;
                });
            });
        }

        // Start polling loop
        setInterval(fetchHistory, 1000);
        fetchHistory();
    </script>
</body>
</html>
"""

def progress_hook(d, download_id):
    """
    Hook called by yt-dlp during the download process.
    Updates the global dictionary with the current progress.
    """
    if d['status'] == 'downloading':
        # Calculate percentage string
        total_bytes = d.get('total_bytes') or d.get('total_bytes_estimate', 0)
        downloaded = d.get('downloaded_bytes', 0)
        if total_bytes > 0:
            percent = (downloaded / total_bytes) * 100
            downloads[download_id]['progress'] = f"{percent:.1f}%"
            downloads[download_id]['status'] = 'downloading'
            
    elif d['status'] == 'finished':
        downloads[download_id]['progress'] = "100%"
        downloads[download_id]['status'] = 'finished'

def background_download(url, download_id):
    """
    The target function run in a separate background thread.
    """
    ydl_opts = {
        'format': 'best',
        'outtmpl': f'%(title)s_{download_id}.%(ext)s',
        # Inject the specific download_id into the hook
        'progress_hooks': [lambda d: progress_hook(d, download_id)],
        'quiet': True,
        'noprogress': True
    }

    try:
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            ydl.download([url])
    except Exception as e:
        downloads[download_id]['status'] = 'error'
        downloads[download_id]['progress'] = str(e)

@app.route('/')
def index():
    # Serve the main UI
    return render_template_string(HTML_TEMPLATE)

@app.route('/api/download', methods=['POST'])
def add_download():
    # Receive URL from front-end
    data = request.json
    url = data.get('url')
    
    if not url:
        return jsonify({"error": "URL is required"}), 400

    # Generate unique ID for this download
    download_id = str(uuid.uuid4())[:8]
    downloads[download_id] = {
        "url": url,
        "status": "starting",
        "progress": "0%"
    }

    # Start the download in a non-blocking background thread
    thread = threading.Thread(target=background_download, args=(url, download_id))
    thread.daemon = True
    thread.start()

    return jsonify({"message": "Download started", "id": download_id})

@app.route('/api/history', methods=['GET'])
def get_history():
    # Return the current state of all downloads
    return jsonify(downloads)

if __name__ == '__main__':
    # Run the Flask app on http://localhost:5000
    app.run(debug=True, port=5000)
